# ─── OpenRouter (required) ─────────────────────────────────────────────
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Optional attribution headers (shown on the OpenRouter dashboard/leaderboards)
OPENROUTER_APP_URL=https://github.com/RushilBuilds/terminal-native-coding-agent
OPENROUTER_APP_NAME=terminal-native-coding-agent

# ─── Model selection ───────────────────────────────────────────────────
# Which entry in the model registry (src/config/models.ts) to use by default.
# One of: default | reasoning | fast  (see the registry for the mapped model IDs)
TNCA_MODEL=default

# Override the raw OpenRouter model slug directly (takes precedence over TNCA_MODEL).
# Examples: anthropic/claude-sonnet-4.5, openai/gpt-5-codex, google/gemini-2.5-pro
# TNCA_MODEL_ID=anthropic/claude-sonnet-4.5

# ─── Cost ceilings (per task) ──────────────────────────────────────────
# Enforced from Day 8; safe to leave defaulted for now.
TNCA_MAX_TURNS=50
TNCA_MAX_TOKENS=200000
TNCA_MAX_USD=5

# ─── Observability (optional, wired up Day 7) ──────────────────────────
# TNCA_OTEL_EXPORTER=console        # console | langfuse
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
