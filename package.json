{
  "name": "terminal-native-coding-agent",
  "version": "0.1.0",
  "description": "A terminal-native AI coding agent built from scratch — plan/act/observe/recover loop, MCP tools, sandboxed execution, hooks, and hard cost ceilings.",
  "type": "module",
  "module": "src/index.ts",
  "bin": {
    "tnca": "src/index.ts"
  },
  "scripts": {
    "ask": "bun run src/cli/ask.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ink": "^7.1.0",
    "react": "^19.2.7",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "0.22.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.2.0",
    "@types/react": "^19.2.17",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "trustedDependencies": ["@biomejs/biome"]
}
